# Server-only configuration for the contact form
# (src/app/api/contact/route.ts). Copy to .env.local (or .env) and fill in —
# these must never appear in client-side code (README §12).

# Required. Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Sender identity — must be a domain you have verified in Resend.
# Default: "Portfolio Contact <onboarding@resend.dev>", which Resend only
# delivers to the email address registered on your Resend account.
RESEND_FROM="Portfolio Contact <onboarding@resend.dev>"
